Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Open", " ", "loop"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Lyapunov", " ", "Solve"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"J", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {
         RowBox[{"-", "\[Beta]x1"}], "0", "0", "0"},
        {"0", 
         RowBox[{"-", "\[Beta]x2"}], "0", "0"},
        {"0", "fyx2p", 
         RowBox[{"-", "\[Beta]y"}], "0"},
        {"fzx1cp", "0", "fzyp", 
         RowBox[{"-", "\[Beta]z"}]}
       }], "\[NoBreak]", ")"}]}], ";"}], " ", 
   RowBox[{"(*", "Jacobian", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"vx1", "0", "0", "vx1z"},
        {"0", "vx2", "vx2y", "vx2z"},
        {"0", "vx2y", "vy", "vyz"},
        {"vx1z", "vx2z", "vyz", "vz"}
       }], "\[NoBreak]", ")"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Covariance", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"No", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {
         RowBox[{"2", "*", "\[Beta]x1", "*", "x1av"}], "0", "0", "0"},
        {"0", 
         RowBox[{"2", "*", "\[Beta]x2", "*", "x2av"}], "0", "0"},
        {"0", "0", 
         RowBox[{"2", "*", "\[Beta]y", "*", "yav"}], "0"},
        {"0", "0", "0", 
         RowBox[{"2", "*", "\[Beta]z", "*", "zav"}]}
       }], "\[NoBreak]", ")"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Noise", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fac", "=", 
     RowBox[{"Factor", "[", 
      RowBox[{
       RowBox[{"J", ".", "S"}], "+", 
       RowBox[{"S", ".", 
        RowBox[{"J", "\[Transpose]"}]}], "+", "No"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e1", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e2", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
