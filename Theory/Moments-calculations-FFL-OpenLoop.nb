Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "FFL", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Lyapunov", " ", "Solve"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"J", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {
         RowBox[{"-", "\[Beta]x"}], "0", "0"},
        {"fyxp", 
         RowBox[{"-", "\[Beta]y"}], "0"},
        {"fzxp", "fzyp", 
         RowBox[{"-", "\[Beta]z"}]}
       }], "\[NoBreak]", ")"}]}], ";"}], " ", 
   RowBox[{"(*", "Jacobian", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"vx", "vxy", "vxz"},
        {"vxy", "vy", "vyz"},
        {"vxz", "vyz", "vz"}
       }], "\[NoBreak]", ")"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Coiance", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"No", "=", 
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {
         RowBox[{"2", "*", "\[Beta]x", "*", "xav"}], "0", "0"},
        {"0", 
         RowBox[{"2", "*", "\[Beta]y", "*", "yav"}], "0"},
        {"0", "0", 
         RowBox[{"2", "*", "\[Beta]z", "*", "zav"}]}
       }], "\[NoBreak]", ")"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Noise", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fac", "=", 
     RowBox[{"Factor", "[", 
      RowBox[{
       RowBox[{"J", ".", "S"}], "+", 
       RowBox[{"S", ".", 
        RowBox[{"J", "\[Transpose]"}]}], "+", "No"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e1", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e2", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e3", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e4", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e5", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e6", "=", 
     RowBox[{"fac", "[", 
      RowBox[{"[", 
       RowBox[{"3", ",", "3"}], "]"}], "]"}]}], " ", ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "Coupled", " ", "equation", " ", "of", " ", "iances", " ", "and", " ", 
     "coiances"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"e1", "==", "0"}], ",", "vx"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"e4", "==", "0"}], ",", "vy"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"e6", "==", "0"}], ",", "vz"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"e2", "==", "0"}], ",", "vxy"}], "]"}], "[", 
