   RowBox[{
    RowBox[{
     RowBox[{"normalizeRob", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"valid", ",", "svals", ",", "smin", ",", "smax"}], "}"}], ",", 
       RowBox[{
        RowBox[{"valid", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ListQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "==", "5"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "4", "]"}], "]"}], "]"}], "&&", 
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "5", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"svals", "=", 
         RowBox[{"valid", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"smin", "=", 
         RowBox[{"Min", "[", "svals", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"smax", "=", 
         RowBox[{"Max", "[", "svals", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"valid", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"smax", "==", "smin"}], ",", "1", ",", 
               RowBox[{"1", "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"valid", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "5"}], "]"}], "]"}], "-", "smin"}], 
                  ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"smax", "-", "smin"}], ")"}]}]}]}], "]"}], "}"}]}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "valid", "]"}]}], "}"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
