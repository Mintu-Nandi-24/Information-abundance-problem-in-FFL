           RowBox[{"Mean", "[", 
            RowBox[{"Abs", "[", "validSens", "]"}], "]"}], ",", 
           "Indeterminate"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "class", ",", "motif", ",", "imi", ",", "absimi", ",", "meanSens"}], 
