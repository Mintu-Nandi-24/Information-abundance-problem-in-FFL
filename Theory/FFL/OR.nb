   RowBox[{
    RowBox[{
     RowBox[{"sensRob", "[", 
      RowBox[{"pars_List", ",", "signs_List", ",", "ind_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pp", ",", "pm", ",", "vp", ",", "vm"}], "}"}], ",", 
       RowBox[{
        RowBox[{"pp", "=", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{"pars", ",", 
           RowBox[{"ind", "->", 
            RowBox[{
             RowBox[{"pars", "[", 
              RowBox[{"[", "ind", "]"}], "]"}], "*", 
             RowBox[{"Exp", "[", "hRob", "]"}]}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pm", "=", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{"pars", ",", 
           RowBox[{"ind", "->", 
            RowBox[{
             RowBox[{"pars", "[", 
              RowBox[{"[", "ind", "]"}], "]"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "hRob"}], "]"}]}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vp", "=", 
         RowBox[{"calcIxzsRob", "[", 
          RowBox[{"pp", ",", "signs"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vm", "=", 
         RowBox[{"calcIxzsRob", "[", 
          RowBox[{"pm", ",", "signs"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericQ", "[", "vp", "]"}], "&&", 
           RowBox[{"NumericQ", "[", "vm", "]"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"vp", "-", "vm"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", "hRob"}], ")"}]}], ",", "Indeterminate"}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
